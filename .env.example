# Sao chép thành .env rồi điền. Không commit .env.
# Crawl một năm tại trạm Hà Nội chỉ cần OPENAQ_API_KEY.
# Open-Meteo (ERA5, CAMS) và kho S3 OpenAQ không dùng khóa.

# Bắt buộc để liệt kê trạm, sensor và giấy phép. Header: X-API-Key
# https://explore.openaq.org/
OPENAQ_API_KEY=

# Demo AQI hiện tại. Không dùng để tải lịch sử train.
# https://aqicn.org/data-platform/token/
WAQI_TOKEN=

# Heatmap / chỉ số vnm_vea sau này. Cần billing, lịch sử tối đa 30 ngày.
# https://developers.google.com/maps/documentation/air-quality/overview
GOOGLE_MAPS_API_KEY=

# CAMS EAC4 trên Atmosphere Data Store, chỉ khi tải GRIB/NetCDF dài hạn.
# https://ads.atmosphere.copernicus.eu/
CDSAPI_URL=https://ads.atmosphere.copernicus.eu/api
CDSAPI_KEY=

# MERRA-2 sau này. https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# OpenWeather Air Pollution. Điểm lat/lon, không phải danh sách trạm.
# Lịch sử từ 27/11/2020, dự báo 4 ngày. https://openweathermap.org/api/air-pollution
OPENWEATHER_API_KEY=
